# Copy this file to ".env" (same folder) and fill in your real values.
# Never share or commit the real .env file.

DB_USER=INTERNHUB
DB_PASSWORD=your_internhub_password
DB_DSN=localhost:1521/XE

# Folder that contains oci.dll from Oracle Instant Client (thick mode is required for 10g).
# Use forward slashes or doubled backslashes. Leave empty if the folder is already on your PATH.
ORACLE_CLIENT_DIR=C:/oracle/instantclient_11_2

SECRET_KEY=replace-with-a-long-random-string
PORT=5000
FLASK_DEBUG=0
